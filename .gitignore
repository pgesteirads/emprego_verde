# R padrão
.Rproj.user
.Rhistory
.RData
.Ruserdata
.RDataTmp*

# Arquivos temporários do R
*.Rout
*.Rdata
*~

# Bases de dados pesadas (parquet, csv grandes)
*.parquet
*.csv
*.feather
*.fst

# Microdados brutos do IBGE (pesados, não versionar)
dados/microdados_ibge/trimestral/

# Dados de referência e brutos (não versionar)
dados/referencia/
dados/pnadc_trim/
dados/deflator/

# Dados processados (gerados pelos scripts)
dados/processados/

# Análise SCN
analise_scn/

# Outputs / produtos intermediários
produtos/produtos-*
produtos/graficos/
produtos/tabelas/
produtos/apresentacoes/
produtos/textos/

# Planilhas de teste
teste*.xlsx
teste*.csv

# Credenciais e configurações locais
.env
*.credentials
secrets.R
config_local.R

# Diretórios do sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Cache
__pycache__/
.cache/

# Arquivos compactados
*.zip
*.tar.gz
*.rar

# Documentos, bibliografia e materiais internos (não versionar)
green skills - bibliografia/
documentacao_bolsa/
proposta_ics/
analise_cbo_onnet/
*.pdf
*.docx
*.xlsx
*.xls

# Indice de esverdeamento: insumos e saidas principais sao versionados
# (as regras acima ignoram *.csv; estas excecoes reabrem o necessario)
!metodologia/insumos/*.csv
!metodologia/saida/indice_por_ocupacao.csv
!metodologia/saida/atividades_por_ocupacao.csv
!metodologia/saida/validacao.csv
metodologia/saida/intermediarios/

# Painel de modelos: a rodada real e versionada; a simulada, nao
!metodologia/painel/**/*.csv
metodologia/painel_simulado/

# Classificacao humana: planilhas, chaves e resultados reais sao versionados
!metodologia/classificacao_humana/**/*.xlsx
!metodologia/classificacao_humana/**/*.csv
metodologia/classificacao_humana_simulada/

# Chaves de API nunca vao para o git
.Renviron
.env*
metodologia/saida/*_R.csv
metodologia/saida/*_py.csv

# Ponte CBO 2002 -> COD: insumos, saidas e nota metodologica versionados
!metodologia/insumos/ponte/*.csv
!metodologia/saida/ponte/*.csv
!metodologia/Nota_metodologica_ponte_CBO_COD.docx
